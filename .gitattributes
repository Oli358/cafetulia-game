# Normalización de finales de línea y archivos binarios
* text=auto eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.avif binary
*.ico binary
*.svg text eol=lf
*.glb binary
*.gltf binary
*.fbx binary
*.obj binary
*.blend binary
*.psd binary
*.mp3 binary
*.ogg binary
*.wav binary
*.woff binary
*.woff2 binary

# Lockfiles y textos
package-lock.json text eol=lf
pnpm-lock.yaml text eol=lf
yarn.lock text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
